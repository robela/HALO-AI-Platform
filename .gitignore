dist/
build/
.next/
coverage/
*.tsbuildinfo

# === BACKEND (Python/FastAPI) ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
