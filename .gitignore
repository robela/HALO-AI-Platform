.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# === ENVIRONMENT VARIABLES ===
.env
.env.local
.env.*.local
.env.production.local

# === IDE & EDITOR ===
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project
.history/

# === LOGS ===
*.log
logs/
