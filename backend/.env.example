# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./halo_ai.db

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Google OAuth ────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Authorised JavaScript origins: http://localhost:5173
# 5. Paste the Client ID below
GOOGLE_CLIENT_ID=397980615504-bk84p5ecc8ml3k5c6raccduk1okqvcdq.apps.googleusercontent.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL(s) allowed to call this backend (comma-separated for multiple)
# Note: In production, use specific origins. In development, use "*" is now auto-enabled.
# Examples:
#   - http://localhost:5173 (local frontend)
#   - https://halo-africa-site-XXXXX.us-central1.run.app (deployed frontend)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
